# RippleCI Configuration Example
# Copy this file to .env for local overrides (never commit real .env files)

# FalkorDB connection URL (default local instance)
RIPPLE_FALKORDB_URL=redis://localhost:6379

# Graph database name for the current repository
RIPPLE_GRAPH_NAME=ripple_default

# Optional FalkorDB authentication (leave empty if none)
RIPPLE_FALKORDB_PASSWORD=

# RippleCI HTTP API settings (used by API and Web UI)
RIPPLE_API_HOST=127.0.0.1
RIPPLE_API_PORT=8000

# Web Companion settings
NEXT_PUBLIC_RIPPLE_API_URL=http://127.0.0.1:8000

# Optional LLM integration settings (core engine operates deterministically without LLM)
# RIPPLE_LLM_PROVIDER=openai
# RIPPLE_LLM_API_KEY=your-api-key-here
